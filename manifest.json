{
  "manifest_version": 3,
  "name": "Twitch Auto Claim",
  "version": "1.0.0",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitch.tv/*",
        "https://twitch.tv/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}