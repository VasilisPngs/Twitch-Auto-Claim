{
  "manifest_version": 3,
  "name": "Twitch Auto Claim",
  "version": "1.0.1",
  "minimum_chrome_version": "152",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
